<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".First_Activity.Fragment_edit_profile_details"
    android:background="#5CCBED">




    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="  save"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:backgroundTint="#5CCBED"
        android:paddingEnd="17dp"
        android:paddingTop="10dp"
        android:layout_marginRight="2dp"
        android:layout_gravity="right"
        android:id="@+id/save_edit_profile_btn" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingBottom="65dp"
            android:layout_marginTop="60dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name :"
                android:textSize="20sp"
                android:paddingStart="17dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:paddingBottom="7dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter name"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:paddingHorizontal="15dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:inputType="phone"
                    android:id="@+id/show_profile_name"
                    android:layout_height="wrap_content"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mobile Number :"
                android:textSize="20sp"
                android:paddingStart="17dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:paddingVertical="7dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Mobile Number"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:paddingHorizontal="15dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:inputType="phone"
                    android:id="@+id/show_profile_mobile_number"
                    android:layout_height="wrap_content"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email Id :"
                android:textSize="20sp"
                android:paddingStart="17dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:paddingVertical="7dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email Id"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:paddingHorizontal="15dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:inputType="phone"
                    android:id="@+id/show_profile_email_id"
                    android:layout_height="wrap_content"/>

            </com.google.android.material.textfield.TextInputLayout>



            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guardian Mobile Number :"
                android:textSize="20sp"
                android:paddingStart="17dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:paddingVertical="7dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Guardian Mobile Number"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:paddingHorizontal="15dp"
                    android:paddingRight="20dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:inputType="phone"
                        android:id="@+id/show_profile_guardian_number"
                        android:layout_height="wrap_content"/>

                    <ImageView
                        android:id="@+id/id_add_guardian_mobile_number_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:paddingTop="10dp"
                        android:paddingEnd="25dp"
                        android:paddingLeft="4dp"
                        android:src="@drawable/add_number_icon" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pin Code :"
                android:textSize="20sp"
                android:paddingStart="17dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:paddingVertical="7dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Pin Code"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:paddingHorizontal="15dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:inputType="phone"
                    android:id="@+id/show_profile_pin_code"
                    android:layout_height="wrap_content"/>

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </ScrollView>



</FrameLayout>